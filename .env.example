# Local development only: copy this file to .env and replace every placeholder.
DB_URL=jdbc:mysql://localhost:3306/grocerycompare?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_local_database_password
DB_ROOT_PASSWORD=replace_with_a_local_root_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_USERS_ENABLED=false

# Frontend build-time setting. Use the backend base URL plus /api for separate hosting.
VITE_API_BASE_URL=/api
